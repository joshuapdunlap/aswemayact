# Cloudflare Workers static assets reads this file from dist/ and does not serve it.
# Hashed build output never changes under the same name, so it is cached for a year.
# Everything else keeps the default (revalidate on each visit).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
