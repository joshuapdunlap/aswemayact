{
  // Cloudflare Workers static assets: no Worker script, only the built site in ./dist.
  // Deploy by hand: `npm run deploy` (see docs/DEPLOY.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aswemayact",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
