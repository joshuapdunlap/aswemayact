---
// Front door: masthead, the trail-blazers epigraph, three entries (manual, trails, the
// name essay), the manual's last-reviewed date, and "Recently added" from git history
// (src/data/recent.json, written by scripts/recent-changes.ts before each build).
import { getCollection } from "astro:content";
import Periodical from "../layouts/Periodical.astro";
import Masthead from "../components/Masthead.astro";
import { formatFolio } from "../lib/dates";
import type { RecentEntry } from "../lib/recent";
import recentJson from "../data/recent.json";

const recent = recentJson as RecentEntry[];
const manual = await getCollection("manual");
const manualReviewed = new Date(Math.max(...manual.map((p) => p.data.reviewed.getTime())));
---

<Periodical
  title="As We May Act"
  section="As We May Act"
  description="Public records in Arkansas, and what to do with them: a field manual, a letter builder and signed trails."
  reviewed={manualReviewed}
>
  <Masthead slot="masthead" />

  <figure class="epigraph">
    <blockquote>
      <p>“…a new profession of trail blazers, those who find delight in the task of establishing useful trails through the enormous mass of the common record.”</p>
    </blockquote>
    <figcaption>— Vannevar Bush, 1945, p. 108</figcaption>
  </figure>

  <article class="entry">
    <h2><a class="headline-link" href="/manual/">Get a record</a></h2>
    <p>The field manual: what the Arkansas Freedom of Information Act lets you see, what it costs and how fast it must come, and a builder that drafts the letter with you.</p>
    <p class="entry__more"><a href="/manual/write/">Draft a request letter<span class="arrow" aria-hidden="true"> →</span></a></p>
    <p class="entry__meta mono">Last reviewed {formatFolio(manualReviewed)}</p>
  </article>

  <article class="entry">
    <h2><a class="headline-link" href="/trails/">Follow a trail</a></h2>
    <p>Short, signed paths that run from a passage or a public record to something you can do. Three to start: the lectern, the meeting and the camera.</p>
  </article>

  <article class="entry">
    <h2><a class="headline-link" href="/about/">Why “As We May Act”</a></h2>
    <p>The name finishes a sentence Vannevar Bush left open in 1945. The essay behind it covers where the idea comes from and what is wrong with where it comes from.</p>
  </article>

  <section class="recent" slot="aside" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="recent__heading small-caps">Recently added</h2>
    <ol role="list">
      {
        recent.map((r) => (
          <li>
            <a href={r.path}>{r.title}</a>
            <time class="mono" datetime={r.date}>{formatFolio(new Date(r.date))}</time>
          </li>
        ))
      }
    </ol>
  </section>
</Periodical>

<style>
  .epigraph {
    margin: 0 0 var(--line-half);
    padding-block: 0 var(--line);
    border-bottom: var(--rule-hair);
  }

  .epigraph blockquote {
    margin: 0;
  }

  /* The opening quotation mark hangs in the margin so the text aligns on its letters. */
  .epigraph p {
    margin: 0;
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.4;
    text-indent: -0.4em;
  }

  .epigraph figcaption {
    margin-top: 0.75rem;
    color: var(--ink-light);
    font-family: var(--font-grotesque);
    font-variant-caps: all-small-caps;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
  }

  .entry {
    padding-block: var(--line-4th) var(--line);
  }

  .entry + .entry {
    border-top: var(--rule-hair);
    padding-top: var(--line-half);
  }

  .entry h2 {
    margin: 0 0 0.375rem;
    font-size: var(--step-2);
  }

  .entry p {
    margin: 0;
  }

  .entry p.entry__more {
    margin-top: 0.5rem;
    font-family: var(--font-grotesque);
  }

  .entry__more a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
  }

  .entry p.entry__meta {
    margin-top: 0.5rem;
    color: var(--ink-light);
    font-size: var(--step--1);
  }

  .recent {
    margin-top: var(--line);
  }

  .recent__heading {
    margin: 0 0 0.5rem;
    color: var(--ink-light);
    font-size: var(--step--1);
  }

  .recent ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent li {
    padding-block: 0.5rem;
    border-top: var(--rule-hair);
  }

  .recent li a {
    display: block;
    min-height: 24px; /* WCAG 2.2 target size: a block link, not inline in a sentence */
  }

  .recent time {
    color: var(--ink-light);
    font-size: var(--step--2);
  }

  @media (min-width: 900px) {
    .recent {
      margin-top: 0;
    }
  }
</style>
