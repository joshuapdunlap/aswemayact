---
// One field-manual page: the Markdown body in the measure, its sources in the aside; the
// sources page also gets the source-card grid below its introduction.
// /manual/printables/ has its own page (printables.astro), so it is not generated here.
import { getCollection, render } from "astro:content";
import Periodical from "../../layouts/Periodical.astro";
import ManualSources from "../../components/ManualSources.astro";
import PrintButton from "../../components/PrintButton.astro";
import SourceCard from "../../components/SourceCard.astro";
import InSection from "../../components/InSection.astro";
import Glance from "../../components/Glance.astro";

// Card order on /manual/sources/: guides first, then helpers, data sites and maps.
const SOURCE_ORDER = [
  "ag-foia-handbook",
  "ag-opinions",
  "rcfp-arkansas",
  "apa-hotline",
  "muckrock-arkansas",
  "arkleg-acts",
  "legiscan-arkansas",
  "transparency-arkansas",
  "sos-ethics-filings",
  "county-clerks",
  "deflock",
  "atlas-of-surveillance",
];
// Records pages that open with "The law in three lines" under their summary.
const GLANCE_PAGES = ["your-rights", "who-may-request", "what-it-costs", "the-clock", "exemptions", "write-a-request", "denied"];

const rank = (id: string) => {
  const i = SOURCE_ORDER.indexOf(id);
  return i === -1 ? SOURCE_ORDER.length : i;
};

export async function getStaticPaths() {
  const pages = await getCollection("manual");
  return pages
    .filter((p) => p.id !== "printables")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, text: h.text }));
const { title, summary, reviewed, sources, printable } = entry.data;
const isSources = entry.id === "sources";
const cards = isSources
  ? (await getCollection("sources")).sort((a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id))
  : [];
---

<Periodical
  title={`${title} · Field manual · As We May Act`}
  section="Field manual"
  reviewed={reviewed}
  description={summary}
  wide={isSources}
>
  <div class="manual-text">
    <div class="manual-head no-print">
      <p class="manual-back"><a href="/manual/">Field manual</a></p>
      {printable && <PrintButton />}
    </div>
    <h1>{title}</h1>
    <p class="manual-summary">{summary}</p>
    {GLANCE_PAGES.includes(entry.id) && <Glance current={entry.id} />}
    <div class="manual-body">
      <Content />
    </div>
  </div>
  {cards.length > 0 && (
    <div class="source-grid">
      {cards.map(({ data }) => <SourceCard {...data} />)}
    </div>
  )}
  {sections.length > 1 && <InSection slot="aside" items={sections} />}
  {sources.length > 0 && <ManualSources slot="aside" sources={sources} />}
</Periodical>
