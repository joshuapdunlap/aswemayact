---
// Served by Workers static assets for any unknown path (wrangler.jsonc:
// not_found_handling "404-page"), with status 404. Kept out of search and the sitemap.
import { getCollection } from "astro:content";
import Periodical from "../layouts/Periodical.astro";

const manual = await getCollection("manual");
const reviewed = new Date(Math.max(...manual.map((p) => p.data.reviewed.getTime())));
---

<Periodical title="Not in the record" section="Not found" reviewed={reviewed} noindex>
  <h1>Not in the record</h1>
  <p>This page is not in the record.</p>
  <ul class="notfound-links" role="list">
    <li><a href="/manual/">The field manual</a></li>
    <li><a href="/trails/">The trails</a></li>
    <li><a href="/search/">Search the site</a></li>
  </ul>
</Periodical>

<style>
  /* Ruled like the other indexes; each link stands alone with a 24px target. */
  .notfound-links {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--rule-hair);
    font-family: var(--font-grotesque);
  }

  .notfound-links li {
    padding-block: 0.375rem;
    border-top: var(--rule-hair);
  }

  .notfound-links a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
  }
</style>
