---
// In-text reference to a sidenote: a numbered superscript that is a real in-page
// anchor. Pair with <Sidenote n={n}> before the paragraph. Markup contract: Sidenote.astro.
interface Props {
  n: number;
}

const { n } = Astro.props;
---

<sup class:list={["sidenote-ref", { "sidenote-ref--2": n >= 10 }]}><a
    href={`#fn-${n}`}
    id={`fnref-${n}`}
    data-popover-target={`fn-${n}`}
    data-popover-media="(max-width: 899.98px)"
  ><span class="visually-hidden">Note </span>{n}</a></sup>
