---
// "Print" button: calls window.print(). Hidden until JavaScript runs (html.js), so a
// reader without scripts is never offered a dead control; they use the browser's Print.
interface Props {
  /** Visible label; defaults to "Print this page". */
  label?: string;
  /** With a sheet id, prints only that .printable-sheet on a page of several. */
  sheet?: string;
}

const { label = "Print this page", sheet } = Astro.props;
---

<button type="button" class="print-button no-print" data-sheet={sheet}>{label}</button>

<script>
  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button.print-button");
    if (!button) return;
    const sheet = button.dataset.sheet;
    const others = sheet
      ? [...document.querySelectorAll<HTMLElement>(".printable-sheet")].filter((s) => s.id !== sheet)
      : [];
    others.forEach((s) => s.classList.add("print-skip"));
    window.addEventListener("afterprint", () => others.forEach((s) => s.classList.remove("print-skip")), { once: true });
    window.print();
  });
</script>

<style>
  /* A small-caps control in the page's furniture (the back-link line on a manual page),
     not a box in the reading line: underlined in the rule colour, in ink on hover. */
  .print-button {
    display: none;
    min-height: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-grotesque);
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    line-height: 1.45;
    cursor: pointer;
  }

  :global(html.js) .print-button {
    display: inline-block;
  }

  .print-button:hover {
    border-bottom-color: var(--ink);
  }
</style>
