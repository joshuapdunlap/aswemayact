---
// Source card: where a kind of record lives, what it costs, its limits, and when
// the editor last checked the link. Set as a catalogue entry: one ink rule over the name,
// each fact a short paragraph led by its small-caps head, the link and the date beneath.
import { formatFolio } from "../lib/dates";
import { hostLabel } from "../lib/cite";
import { breakUrls } from "../lib/typography";

interface Props {
  name: string;
  holder: string;
  whatItHolds: string;
  cost: string;
  limits: string;
  url: string;
  checked: Date;
  /** Heading level for the card's name; 2 on a page of cards, 3 under a section. */
  level?: 2 | 3 | 4;
}

const { name, holder, whatItHolds, cost, limits, url, checked, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<article class="source-card">
  <Heading class="source-card__name">{name}</Heading>
  <dl class="source-card__facts">
    <div>
      <dt class="small-caps">Held by</dt>
      <dd set:html={breakUrls(holder)} />
    </div>
    <div>
      <dt class="small-caps">What it holds</dt>
      <dd set:html={breakUrls(whatItHolds)} />
    </div>
    <div>
      <dt class="small-caps">Cost</dt>
      <dd set:html={breakUrls(cost)} />
    </div>
    <div>
      <dt class="small-caps">Limits</dt>
      <dd set:html={breakUrls(limits)} />
    </div>
  </dl>
  <p class="source-card__foot">
    <a href={url}>{hostLabel(url)}</a>
    <span class="mono">Checked {formatFolio(checked)}</span>
  </p>
</article>

<style>
  .source-card {
    margin: 0 0 var(--line-1-5);
    padding-top: var(--line-half);
    border-top: var(--rule-ink);
  }

  .source-card__name {
    margin: 0 0 var(--line-half);
    font-size: var(--step-1);
  }

  .source-card__facts {
    margin: 0;
  }

  /* A run-in head: the label leads its paragraph on the same line. */
  .source-card__facts > div {
    margin: 0 0 var(--line-4th);
  }

  .source-card__facts dt,
  .source-card__facts dd {
    display: inline;
  }

  .source-card__facts dt {
    margin-right: 0.375em;
    color: var(--ink-light);
    font-size: var(--step--1);
  }

  .source-card__facts dd {
    margin: 0;
  }

  .source-card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--gutter);
    margin: var(--line-half) 0 0;
    font-size: var(--step--1);
  }

  /* The link stands alone: a 24px target (WCAG 2.2 SC 2.5.8). */
  .source-card__foot a {
    display: inline-block;
    min-height: 24px;
    line-height: 24px;
  }

  .source-card__foot .mono {
    color: var(--ink-light);
    font-size: var(--step--2);
    line-height: 24px;
  }
</style>
