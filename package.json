{
  "name": "aswemayact",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build",
    "build:test": "npm run prebuild && npm run check -- --skip-links && astro build && npm run postbuild",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsx scripts/check-content.ts",
    "prebuild": "tsx scripts/recent-changes.ts",
    "postbuild": "pagefind --site dist",
    "archive": "tsx scripts/archive-links.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "test": "vitest run && playwright test",
    "lhci": "node scripts/lhci.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@types/hast": "3.0.5",
    "@types/node": "^22.20.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "pagefind": "^1.5.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "11.0.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
