{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/manual/",
        "http://127.0.0.1:4322/manual/the-clock/",
        "http://127.0.0.1:4322/manual/write/",
        "http://127.0.0.1:4322/manual/sources/",
        "http://127.0.0.1:4322/manual/printables/",
        "http://127.0.0.1:4322/trails/",
        "http://127.0.0.1:4322/trails/the-lectern/",
        "http://127.0.0.1:4322/trails/the-camera/",
        "http://127.0.0.1:4322/about/",
        "http://127.0.0.1:4322/corrections/",
        "http://127.0.0.1:4322/search/"
      ],
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4322 --ignore-lock",
      "startServerReadyPattern": "127.0.0.1:4322",
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 204800
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 120000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
